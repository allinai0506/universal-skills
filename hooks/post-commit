#!/usr/bin/env bash
# =============================================================================
# Git post-commit hook for universal-skills
# 每次 commit 后自动：
#   1. 运行 sync.sh 将技能同步到所有本地 Agent（Claude/Cursor/Codex/Gemini）
#   2. Push 到远端（自动探测上游远端，不硬编码 origin）
# =============================================================================

REPO_DIR="$(git rev-parse --show-toplevel)"
SYNC_SCRIPT="$REPO_DIR/sync.sh"

# 颜色
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

echo ""
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${CYAN}  🔄 [post-commit] 技能同步触发中...${RESET}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"

# ─── 步骤 1: 检测本次 commit 是否涉及技能文件 ─────────────────────────────
CHANGED_SKILLS=$(git diff-tree --no-commit-id -r --name-only HEAD | grep -E "^(categories|skills)/.*SKILL\.md$" || true)

if [ -z "$CHANGED_SKILLS" ]; then
    echo -e "${YELLOW}  ℹ️  本次 commit 未涉及技能文件，跳过同步${RESET}"
    exit 0
fi

echo -e "${GREEN}  📝 检测到以下技能文件变更:${RESET}"
echo "$CHANGED_SKILLS" | while read -r f; do
    echo "     • $f"
done
echo ""

# ─── 步骤 2: 运行 sync.sh 同步到所有本地 Agent ─────────────────────────────
if [ -x "$SYNC_SCRIPT" ]; then
    echo -e "${CYAN}  🚀 步骤 1/2: 同步到本地 Agents...${RESET}"
    cd "$REPO_DIR" && bash "$SYNC_SCRIPT" 2>&1 | grep -E "(✓|✗|→|ERROR|已同步|警告|success)" | sed 's/^/    /'
    echo ""
else
    echo "  ⚠️  sync.sh 不可执行，跳过本地同步"
fi

# ─── 步骤 3: Push 到远端（自动探测上游远端，不硬编码 origin）─────────────
echo -e "${CYAN}  ☁️  步骤 2/2: 推送到远端...${RESET}"

CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "main")

# 探测策略：分支绑定的远端（直接读配置）→ 仓库第一个远端 → 跳过
# 不用 @{u}：分支无上游时解析不可靠，可能把字面量当远端名传给 git push
_cfg_remote=$(git config "branch.$CURRENT_BRANCH.remote" 2>/dev/null || true)
if [ -n "$_cfg_remote" ] && git remote 2>/dev/null | grep -qx "$_cfg_remote"; then
    REMOTE="$_cfg_remote"
else
    # 无上游绑定时，取仓库配置里的第一个远端
    REMOTE=$(git remote 2>/dev/null | head -n1 || true)
fi

if [ -z "$REMOTE" ]; then
    echo -e "${YELLOW}  ⚠️  未配置任何 git 远端，跳过 push${RESET}"
else
    if git push "$REMOTE" "$CURRENT_BRANCH" 2>&1; then
        echo -e "${GREEN}  ✅ 已推送到 $REMOTE/$CURRENT_BRANCH${RESET}"
    else
        echo -e "${YELLOW}  ⚠️  Push 到 $REMOTE/$CURRENT_BRANCH 失败（可能无网络或需要认证），请手动执行: git push $REMOTE $CURRENT_BRANCH${RESET}"
    fi
fi

echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${GREEN}  ✨ 同步完成！${RESET}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""

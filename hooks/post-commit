#!/usr/bin/env bash
# =============================================================================
# Git post-commit hook for universal-skills
# 每次 commit 后自动：
#   1. 运行 sync.sh 将技能同步到所有本地 Agent（Claude/Cursor/Codex/Gemini）
#   2. Push 到远端（自动探测上游远端，不硬编码 origin）
# =============================================================================

REPO_DIR="$(git rev-parse --show-toplevel)"
SYNC_SCRIPT="$REPO_DIR/sync.sh"

# 颜色
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

echo ""
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${CYAN}  🔄 [post-commit] 技能同步触发中...${RESET}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"

# ─── 步骤 1: 检测本次 commit 是否涉及技能文件 ─────────────────────────────
CHANGED_SKILLS=$(git diff-tree --no-commit-id -r --name-only HEAD | grep -E "^(categories|skills)/.*SKILL\.md$" || true)

if [ -z "$CHANGED_SKILLS" ]; then
    echo -e "${YELLOW}  ℹ️  本次 commit 未涉及技能文件，跳过同步${RESET}"
    exit 0
fi

echo -e "${GREEN}  📝 检测到以下技能文件变更:${RESET}"
echo "$CHANGED_SKILLS" | while read -r f; do
    echo "     • $f"
done
echo ""

# ─── 步骤 1.5: 更新变更技能的 version + synced-at ──────────────────────
# 对每个变更的 SKILL.md 自动递增版本号（YYYY.MM.DD-N）并写入同步时间戳。
# 若本次 commit 对该文件的改动仅为 version/synced-at 戳记本身（即 lock 提交），
# 则跳过 bump——否则每次提交都让计数器空转 +1，工作树永远是脏的。
for skill_md in $CHANGED_SKILLS; do
    skill_path="$REPO_DIR/$skill_md"
    if git rev-parse -q --verify HEAD~1 >/dev/null 2>&1; then
        substantive=$(git diff --no-color HEAD~1 HEAD -- "$skill_path" 2>/dev/null \
            | grep -E "^[+-]" | grep -vE "^[+-]{3}" \
            | grep -vE "^[+-][[:space:]]*(version|synced-at):" || true)
        if [ -z "$substantive" ]; then
            echo -e "${YELLOW}  ⏭️  $skill_md 本次仅戳记变更，跳过版本号递增${RESET}"
            continue
        fi
    fi
    if [ -f "$skill_path" ]; then
        python3 - <<'PYEOF' "$skill_path"
import sys, re, datetime
path = sys.argv[1]
with open(path, 'r', encoding='utf-8') as f:
    content = f.read()

# 仅在 YAML frontmatter 区域内操作；正文中的 version:/synced-at: 字面量
# （如模板示例文本）必须保持原样，否则 re.sub 会污染正文。
fm = re.match(r'^---\n.*?\n---\n', content, re.DOTALL)
if not fm:
    print(f"  ⚠️  {path}: 无 frontmatter，跳过戳记更新")
    sys.exit(0)
frontmatter, body = content[:fm.end()], content[fm.end():]

today = datetime.datetime.now().strftime("%Y.%m.%d")
existing_ver = re.search(r'version:\s*"([^"]+)"', frontmatter)
if existing_ver:
    existing = existing_ver.group(1)
    if existing.startswith(today):
        match = re.match(rf'{today}-(\d+)', existing)
        counter = int(match.group(1)) + 1 if match else 1
        new_version = f"{today}-{counter}"
    else:
        new_version = f"{today}-1"
else:
    new_version = f"{today}-1"

synced_at = datetime.datetime.now().isoformat(timespec='seconds')

if existing_ver:
    frontmatter = re.sub(r'version:\s*"[^"]*"', f'version: "{new_version}"', frontmatter, count=1)
else:
    frontmatter = re.sub(r'(name:\s*\S+)', r'\1\nversion: "' + new_version + '"', frontmatter, count=1)

if 'synced-at:' in frontmatter:
    frontmatter = re.sub(r'synced-at:\s*"[^"]*"', f'synced-at: "{synced_at}"', frontmatter, count=1)
else:
    frontmatter = re.sub(r'(version:\s*"[^"]*")', r'\1\nsynced-at: "' + synced_at + '"', frontmatter, count=1)

with open(path, 'w', encoding='utf-8') as f:
    f.write(frontmatter + body)
print(f"  📌 {path}: version={new_version}, synced-at={synced_at}")
PYEOF
    fi
done
echo ""

# ─── 步骤 2: 运行 sync.sh 同步到本地 Agent ─────────────────────────────
# --no-projects：项目级全量重建（40+ 项目 × 4 目录 × 230 技能 ≈ 3-5 分钟）是
# post-commit 挂起的根因；SKILL.md 内容变更经 symlink 即时生效，无需重建。
# 全局同步（含 TraeCode 真实副本）保留。新增/删除技能目录时手动跑 ./sync.sh。
if [ -x "$SYNC_SCRIPT" ]; then
    echo -e "${CYAN}  🚀 步骤 1/2: 同步到本地 Agents（跳过项目级）...${RESET}"
    cd "$REPO_DIR" && bash "$SYNC_SCRIPT" --no-projects 2>&1 | grep -E "(✓|✗|→|ERROR|已同步|警告|success)" | sed 's/^/    /'
    echo ""
else
    echo "  ⚠️  sync.sh 不可执行，跳过本地同步"
fi

# ─── 步骤 3: Push 到远端（自动探测上游远端，不硬编码 origin）─────────────
echo -e "${CYAN}  ☁️  步骤 2/2: 推送到远端...${RESET}"

CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "main")

# 探测策略：分支绑定的远端（直接读配置）→ 仓库第一个远端 → 跳过
# 不用 @{u}：分支无上游时解析不可靠，可能把字面量当远端名传给 git push
_cfg_remote=$(git config "branch.$CURRENT_BRANCH.remote" 2>/dev/null || true)
if [ -n "$_cfg_remote" ] && git remote 2>/dev/null | grep -qx "$_cfg_remote"; then
    REMOTE="$_cfg_remote"
else
    # 无上游绑定时，取仓库配置里的第一个远端
    REMOTE=$(git remote 2>/dev/null | head -n1 || true)
fi

if [ -z "$REMOTE" ]; then
    echo -e "${YELLOW}  ⚠️  未配置任何 git 远端，跳过 push${RESET}"
else
    if git push "$REMOTE" "$CURRENT_BRANCH" 2>&1; then
        echo -e "${GREEN}  ✅ 已推送到 $REMOTE/$CURRENT_BRANCH${RESET}"
    else
        echo -e "${YELLOW}  ⚠️  Push 到 $REMOTE/$CURRENT_BRANCH 失败（可能无网络或需要认证），请手动执行: git push $REMOTE $CURRENT_BRANCH${RESET}"
    fi
fi

echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${GREEN}  ✨ 同步完成！${RESET}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""
